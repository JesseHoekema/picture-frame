# Copy to the project root as `.env` and adjust.
# The systemd service loads this file.

HOST=0.0.0.0
PORT=3000

# Origins allowed to submit the dashboard forms and share-link uploads,
# comma-separated. Same-origin is ALWAYS allowed, so opening the app from any of
# these URLs just works. The installer fills in your hostname, LAN IP and
# localhost automatically — add more here if you reach the Pi another way.
ALLOWED_ORIGINS=http://raspberrypi.local:3000,http://localhost:3000

# Allow large photo uploads (SvelteKit adapter-node default is only 512K).
BODY_SIZE_LIMIT=100M

NODE_ENV=production

# Optional overrides (defaults are under ./data):
# DATABASE_PATH=data/picture-frame.db
# UPLOAD_DIR=data/uploads
# MEDIA_CACHE_DIR=data/cache
