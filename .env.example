# Picture Frame configuration.
#
# Copy this file to `.env` and adjust:
#     cp .env.example .env
#
# In development (`pnpm dev`) it is loaded automatically.
# In production it is loaded when you start the server with:
#     node -r dotenv/config build
# (The Raspberry Pi installer loads it via the systemd service instead.)

# --- Server (production / adapter-node) ---
HOST=0.0.0.0
PORT=3000

# Max upload size. adapter-node defaults to only 512K, so raise this or photo
# uploads (including via share links) will fail.
BODY_SIZE_LIMIT=100M

# --- Access ---
# Extra origins allowed to submit dashboard forms and share-link uploads,
# comma-separated. Same-origin is ALWAYS allowed, so opening the app by hostname,
# LAN IP or localhost already works — only add URLs you reach it by some other way.
# IMPORTANT: share links only work when the URL people open is an allowed origin.
# ALLOWED_ORIGINS=http://picframe.local:3000,http://192.168.1.50:3000

# --- Data locations (optional; defaults live under ./data) ---
# DATABASE_PATH=data/picture-frame.db
# UPLOAD_DIR=data/uploads
# MEDIA_CACHE_DIR=data/cache
